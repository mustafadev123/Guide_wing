# GuideWing iMessage agent. Copy to imessage-agent/.env (git-ignored) and fill in locally.
# Never commit real values.

# From app.photon.codes -> your project -> Spectrum
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Responder phone number(s) allowed to accept and resolve requests, E.164, comma-separated.
# Example: +15551234567
GUIDEWING_IMESSAGE_ALLOWED=

# GuideWing backend (same laptop by default)
GUIDEWING_URL=http://127.0.0.1:8000
