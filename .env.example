# GuideWing configuration. Copy to .env (git-ignored) and fill in only what you need.
# scripts\start.ps1 loads .env into the server process (values are never printed).
# Its -Camera/-Video/-NoVision flags always decide GUIDEWING_VISION_SOURCE.

GUIDEWING_VISION_SOURCE=0            # webcam index, video file path, or empty to disable
GUIDEWING_CANCEL_WINDOW_S=10
GUIDEWING_ROUTE_DURATION_S=90
GUIDEWING_DEV_CONTROLS=1             # 0 hides /dev and /api/dev/*
GUIDEWING_PATH_REGION=0.25,0.45,0.75,1.0   # normalized x1,y1,x2,y2 monitored image region
GUIDEWING_CHAIR_CONFIDENCE=0.45
GUIDEWING_REGION_OVERLAP=0.25
GUIDEWING_OBSTRUCTION_PERSIST_S=1.0
GUIDEWING_OBSTRUCTION_COOLDOWN_S=10
GUIDEWING_PALM_SCORE=0.6
GUIDEWING_PALM_HOLD_S=2.0
GUIDEWING_SNAPSHOTS=1
GUIDEWING_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional sponsor providers. Leave empty to use browser speech and deterministic briefings.
# Never commit real keys. Startup works without them.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
